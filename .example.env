# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
BACKEND_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=*

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=goldentak_db

# Local Docker Postgres (Host access via localhost:5432)
DATABASE_URL="postgresql://postgres:123456@localhost:5432/goldentak_db?schema=public"
DIRECT_URL="postgresql://postgres:123456@localhost:5432/goldentak_db?schema=public"

# ─── Production Supabase Database (Commented out) ─────────────────────────────
# DATABASE_URL="postgresql://postgres.aiafflrtfloqgjnskikd:TestDatabase123%40@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# DIRECT_URL="postgresql://postgres.aiafflrtfloqgjnskikd:TestDatabase123%40@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local Docker Redis (Host access via localhost:6379)
REDIS_URL="redis://127.0.0.1:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUND=10
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_IN=7d
JWT_REFRESH_EXPIRE_IN=30d

# ─── Racing API ────────────────────────────────────────────────────────────────
RACING_API_KEY=your_racing_api_key
RACING_API_SECRET=your_racing_api_secret

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_FROM=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# ─── Super Admin Seed ─────────────────────────────────────────────────────────
NAME=Admin
EMAIL=admin@gmail.com
PHONE=0000000000
PASSWORD=12345678
AVATAR=https://i.ibb.co/VWkMFBWM/pngtree-user-icon-png-image-1796659.jpg

# ─── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Google Play Billing ──────────────────────────────────────────────────────
GOOGLE_PLAY_CLIENT_EMAIL=your_play_billing_client_email
GOOGLE_PLAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Apple App Store Connect ───────────────────────────────────────────────
APPLE_KEY_ID=your_apple_key_id
APPLE_ISSUER_ID=your_apple_issuer_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
APPLE_BUNDLE_ID=your_apple_bundle_id
APPLE_SHARED_SECRET=your_apple_app_specific_shared_secret