model Horse {
  id          String  @id @default(cuid())
  externalId  String? @unique
  name        String  @unique
  age         Int?
  color       String?
  sex         String?
  sireName    String? // Father
  damName     String? // Mother
  damSireName String? // Mother's Father
  owner       String?
  trainer     String?
  country     String?
  bestTime    String?
  bestTimeLocation String?

  // Denormalized stats for fast calculation
  totalRaces    Int       @default(0)
  wins          Int       @default(0)
  seconds       Int       @default(0)
  thirds        Int       @default(0)
  fourths       Int       @default(0)
  totalEarnings Float     @default(0)
  lastRaceDate  DateTime?

  // Pedigree Stats (Cached from offspring performance)
  sireWinRate      Float?
  sirePlaceRate    Float?
  damWinRate       Float?
  damPlaceRate     Float?
  damSireWinRate   Float?
  damSirePlaceRate Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries RaceEntry[]
  results RaceResult[]

  @@map("horses")
}

model Jockey {
  id         String  @id @default(cuid())
  externalId String? @unique
  name       String

  // Career stats
  totalRides Int @default(0)
  wins       Int @default(0)
  seconds    Int @default(0)
  thirds     Int @default(0)
  fourths    Int @default(0)

  // Recent form
  ridesLast30d Int @default(0)
  winsLast30d  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries RaceEntry[]
  results RaceResult[]

  @@map("jockeys")
}

model Race {
  id         String     @id @default(cuid())
  externalId String     @unique
  name       String?
  date       DateTime
  time       String
  location   String
  country    String     @default("United Kingdom")
  trackType  String? // Turf, Sand, Synthetic
  distance   String?
  prize      String?
  status     RaceStatus @default(UPCOMING)

  // Tahmin / Predictions
  tahmin1X String?
  riskRate Int?
  predictionMessage String?
  hasPredictions    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries RaceEntry[]
  results RaceResult[]

  @@map("races")
}

model RaceEntry {
  id         String  @id @default(cuid())
  raceId     String
  horseId    String
  jockeyId   String?
  jockeyName String?
  trainerName String?
  weight     Float?
  draw       Int?

  // Individual Scores
  horsePower    Float?
  jockeyPower   Float?

  // Final Results
  normalizedScore Float?
  rank            Int?
  category        Category?

  // AI Prediction Details — Core Markets
  winProb                  Float?
  winOddsFair              Float?
  placeProb                Float?
  eachWayProb              Float?   // Each Way market probability
  goingSuitabilityScore    Float?
  distanceSuitabilityScore Float?
  courseSpecialistScore    Float?   // Course Specialist score
  drawBiasScore            Float?   // Draw Bias score
  jockeyFormScore          Float?
  trainerFormScore         Float?
  aiSelectionRank          Int?
  aiConfidence             String?
  aiConfidenceScore        Float?
  aiAnalysis               String?  @db.Text

  // AI Value Edge — flags underpriced horses vs bookmaker odds
  hasValueEdge    Boolean?  // true if AI fair odds > bookmaker price
  valueEdgePercent Float?   // e.g. 12.5 means 12.5% edge

  race   Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)
  horse  Horse   @relation(fields: [horseId], references: [id], onDelete: Cascade)
  jockey Jockey? @relation(fields: [jockeyId], references: [id])

  @@unique([raceId, horseId])
  @@map("race_entries")
}

model RaceResult {
  id       String  @id @default(cuid())
  raceId   String
  horseId  String
  jockeyId String?
  position Int
  time     String?
  earnings Float?

  race   Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)
  horse  Horse   @relation(fields: [horseId], references: [id], onDelete: Cascade)
  jockey Jockey? @relation(fields: [jockeyId], references: [id])

  @@unique([raceId, horseId])
  @@map("race_results")
}
